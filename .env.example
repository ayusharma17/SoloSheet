# Supabase browser/session configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Supabase key. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Server-only extraction provider configuration
GOOGLE_API_KEY=your-google-api-key
# GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Stripe Checkout. Use test-mode values for development.
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PRICE_ID=your-stripe-price-id
APP_URL=http://127.0.0.1:3000

# Development-only local Supabase login. Keep false in hosted environments.
NEXT_PUBLIC_ENABLE_TEST_AUTH=false
